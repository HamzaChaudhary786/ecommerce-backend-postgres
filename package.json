{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Express.js backend with PostgreSQL/Prisma",
  "main": "server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "stripe:listen": "stripe listen --forward-to localhost:5000/api/payments/webhook",
    "dev:all": "npx concurrently \"npm run dev\" \"npm run stripe:listen\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "stripe": "^21.0.1",
    "twilio": "^5.13.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}