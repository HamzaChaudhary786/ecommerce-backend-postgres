generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────

enum BusinessType {
  MANUFACTURER
  SUPPLIER
  EXPORTER
  WHOLESALER
  IMPORTER
  RETAILER
  BUSINESS_BUYER
  NORMAL_BUYER
}

enum UserRole {
  buyer
  seller
  admin
  subadmin
}

enum SellerLevel {
  top_rated
  above_standard
  below_standard
}

enum ListingType {
  fixed_price
  auction
  buy_it_now_auction
}

enum ListingStatus {
  draft
  active
  ended
  sold
  cancelled
  suspended
  pending_approval
  rejected
}

enum ItemCondition {
  new
  open_box
  certified_refurbished
  excellent_refurbished
  very_good_refurbished
  good_refurbished
  seller_refurbished
  used_excellent
  used_very_good
  used_good
  used_acceptable
  for_parts
}

enum OrderStatus {
  pending
  payment_pending
  paid
  processing
  processed
  partially_shipped
  shipped
  out_for_delivery
  delivered
  partially_delivered
  cancelled
  refunded
  disputed
}

enum ItemStatus {
  pending
  paid
  processing
  processed
  shipped
  out_for_delivery
  delivered
  cancelled
  returned
  refunded
  return_in_progress
}

enum PaymentStatus {
  pending
  paid
  partially_refunded
  fully_refunded
  failed
}

enum PayoutStatus {
  none
  processing
  paid
  failed
}

enum ReturnStatus {
  none
  pending
  approved
  rejected
  refunded
}

enum OfferStatus {
  pending
  accepted
  declined
  countered
  expired
  cancelled
  completed
}

enum FeedbackRating {
  positive
  neutral
  negative
}

enum FeedbackRole {
  buyer_to_seller
  seller_to_buyer
}

enum FlashSaleStatus {
  pending
  approved
  rejected
  active
  ended
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum EmailCampaignType {
  flash_sale
  deal
}

enum EmailStatus {
  not_sent
  sent
  failed
}

enum DealStatus {
  pending
  approved
  rejected
}

enum QuestionStatus {
  pending
  answered
}

enum BidStatus {
  active
  outbid
  won
  lost
  retracted
}

enum SupportStatus {
  open
  in_progress
  resolved
}

enum SupportPriority {
  low
  medium
  high
}

enum SupportType {
  buyer_query
  seller_query
}

enum ConversationType {
  item_inquiry
  order_issue
  offer
  general
}

enum PaymentGateway {
  stripe
  paypal
  braintree
  easypaisa
  jazzcash
}

enum PaymentMethodType {
  credit_card
  debit_card
  paypal
  bank_account
  apple_pay
  google_pay
}

enum TransactionStatus {
  pending
  processing
  succeeded
  failed
  cancelled
  refunded
  partially_refunded
  disputed
}

enum CategoryAttributeType {
  text
  number
  select
  multiselect
  boolean
}

enum ShippingType {
  free
  flat_rate
  calculated
  freight
  local_pickup
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id                      String      @id @default(uuid())
  name                    String?
  firstName               String?
  lastName                String?
  username                String?     @unique
  email                   String      @unique
  password                String?
  googleId                String?     @unique
  avatar                  String?
  phone                   String      @default("")
  dateOfBirth             DateTime?
  role                    UserRole    @default(buyer)
  permissions             String[]    @default([])
  isVerified              Boolean     @default(false)
  isSuspended             Boolean     @default(false)
  feedbackScore           Int         @default(0)
  positiveFeedbackPercent Float       @default(100)
  totalSales              Int         @default(0)
  totalPurchases          Int         @default(0)
  registeredSeller        Boolean      @default(false)
  sellerLevel             SellerLevel  @default(above_standard)
  businessType            BusinessType?
  emailVerificationToken  String?
  emailVerificationExpires DateTime?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  lastLogin               DateTime?
  notifEmail              Boolean     @default(true)
  notifSms                Boolean     @default(false)
  notifPush               Boolean     @default(true)
  watchlist               String[]    @default([]) // array of listing IDs
  savedSearches           Json[]      @default([])
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  // Relations
  addresses         Address[]
  paymentMethods    PaymentMethod[]
  listings          Listing[]                 @relation("SellerListings")
  bids              Bid[]
  orders            Order[]                   @relation("BuyerOrders")
  ordersAsSeller    OrderItem[]               @relation("SellerItems")
  reviews           Review[]
  feedbackGiven     Feedback[]                @relation("ReviewerFeedback")
  feedbackReceived  Feedback[]                @relation("RevieweeFeedback")
  offersAsBuyer     Offer[]                   @relation("BuyerOffers")
  offersAsSeller    Offer[]                   @relation("SellerOffers")
  supportTickets    SupportTicket[]           @relation("TicketUser")
  assignedTickets   SupportTicket[]           @relation("AssignedTickets")
  ticketResponses   TicketResponse[]
  questions         Question[]                @relation("BuyerQuestions")
  questionsAsSeller Question[]                @relation("SellerQuestions")
  flashSales        FlashSale[]
  payments          Payment[]                 @relation("BuyerPayments")
  paymentsAsSeller  Payment[]                 @relation("SellerPayments")
  store             SellerStore?
  conversations     ConversationParticipant[]
  messages          Message[]
  notifications     Notification[]
  storeViews        StoreView[]
  cart              Cart?
  disputesAsBuyer   Dispute[]                 @relation("BuyerDisputes")
  disputesAsSeller  Dispute[]                 @relation("SellerDisputes")

  @@index([email])
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String?
  phone      String?
  street     String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  isDefault  Boolean @default(false)
}

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String     @default("")
  image        String     @default("")
  icon         String     @default("")
  parentId     String?
  parent       Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryChildren")
  ancestors    Json[]     @default([]) // [{id, name, slug}]
  level        Int        @default(0)
  isActive     Boolean    @default(true)
  isFeatured   Boolean    @default(false)
  sortOrder    Int        @default(0)
  listingCount Int        @default(0)
  attributes   Json[]     @default([]) // [{name, key, type, options, unit, isRequired, isFilterable, isSearchable}]
  metaTitle    String?
  metaDesc     String?
  metaKeywords String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  listings    Listing[] @relation("ListingCategory")
  sublistings Listing[] @relation("ListingSubcategory")

  @@index([slug])
  @@index([parentId])
}

model Listing {
  id                        String        @id @default(uuid())
  title                     String
  subtitle                  String?
  description               String
  sellerId                  String
  seller                    User          @relation("SellerListings", fields: [sellerId], references: [id])
  categoryId                String
  category                  Category      @relation("ListingCategory", fields: [categoryId], references: [id])
  subcategoryId             String?
  subcategory               Category?     @relation("ListingSubcategory", fields: [subcategoryId], references: [id])
  listingType               ListingType   @default(fixed_price)
  status                    ListingStatus @default(draft)
  price                     Float?
  startingBid               Float?
  currentBid                Float?
  reservePrice              Float?
  buyItNowPrice             Float?
  originalPrice             Float?
  bidCount                  Int           @default(0)
  highestBidderId           String?
  auctionStartTime          DateTime?
  auctionEndTime            DateTime?
  autoExtend                Boolean       @default(false)
  condition                 ItemCondition
  conditionDescription      String?
  brand                     String?
  model                     String?
  sku                       String?
  upc                       String?
  isbn                      String?
  mpn                       String?
  attributes                Json[]        @default([])
  materials                 String[]      @default([])
  warranty                  String?
  careInstructions          String?
  images                    Json[]        @default([])
  videos                    Json[]        @default([])
  quantity                  Int           @default(1)
  quantitySold              Int           @default(0)
  variations                Json[]        @default([])
  shipping                  Json          @default("{}")
  returns                   Json          @default("{}")
  location                  Json          @default("{}")
  startTime                 DateTime      @default(now())
  endTime                   DateTime?
  duration                  Int           @default(7)
  views                     Int           @default(0)
  watchers                  Int           @default(0)
  watchersList              String[]      @default([])
  favoriteCount             Int           @default(0)
  averageRating             Float         @default(0)
  reviewCount               Int           @default(0)
  isFeatured                Boolean       @default(false)
  featuredUntil             DateTime?
  isDealOfTheDay            Boolean       @default(false)
  dealStatus                DealStatus    @default(approved)
  dealDiscountPercent       Float         @default(0)
  emailStatus               EmailStatus   @default(not_sent)
  emailSentAt               DateTime?
  promotions                Json[]        @default([])
  isDigital                 Boolean       @default(false)
  isBestOfferEnabled        Boolean       @default(false)
  bestOfferAutoAcceptPrice  Float?
  bestOfferAutoDeclinePrice Float?
  isGlobalShipping          Boolean       @default(false)
  isCharityListing          Boolean       @default(false)
  charityPercent            Float?
  tags                      String[]      @default([])
  searchKeywords            String[]      @default([])
  endingSoonNotified        Boolean       @default(false)
  acceptedPayments          String[]      @default([])
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  bids          Bid[]
  orderItems    OrderItem[]
  reviews       Review[]
  flashSales    FlashSale[]
  offers        Offer[]
  questions     Question[]
  feedbacks     Feedback[]
  conversations Conversation[]
  cartItems     CartItem[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Bid {
  id               String    @id @default(uuid())
  listingId        String
  listing          Listing   @relation(fields: [listingId], references: [id])
  bidderId         String
  bidder           User      @relation(fields: [bidderId], references: [id])
  amount           Float
  maxAmount        Float?
  isAutoBid        Boolean   @default(false)
  isWinning        Boolean   @default(false)
  isRetracted      Boolean   @default(false)
  retractionReason String?
  ipAddress        String?
  status           BidStatus @default(active)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([listingId])
  @@index([bidderId])
}

model Order {
  id                 String        @id @default(uuid())
  orderNumber        String        @unique
  buyerId            String
  buyer              User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  items              OrderItem[]
  status             OrderStatus   @default(pending)
  statusHistory      Json[]        @default([])
  shippingAddress    Json          @default("{}")
  billingAddress     Json          @default("{}")
  subtotal           Float
  shippingTotal      Float         @default(0)
  taxTotal           Float         @default(0)
  discountTotal      Float         @default(0)
  couponCode         String?
  couponDiscount     Float         @default(0)
  total              Float
  paymentId          String?
  payment            Payment?      @relation(fields: [paymentId], references: [id])
  paymentStatus      PaymentStatus @default(pending)
  paymentMethod      String?
  isAuction          Boolean       @default(false)
  isBestOffer        Boolean       @default(false)
  offerId            String?
  offer              Offer?        @relation(fields: [offerId], references: [id])
  buyerNote          String?
  sellerNote         String?
  adminNote          String?
  paidAt             DateTime?
  processedAt        DateTime?
  shippedAt          DateTime?
  outForDeliveryAt   DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  hasDispute         Boolean       @default(false)
  payoutStatus       PayoutStatus  @default(none)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  reviews   Review[]
  feedbacks Feedback[]
  disputes  Dispute[]

  @@index([buyerId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id                     String       @id @default(uuid())
  orderId                String
  order                  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId              String
  listing                Listing      @relation(fields: [listingId], references: [id])
  sellerId               String
  seller                 User         @relation("SellerItems", fields: [sellerId], references: [id])
  title                  String
  image                  String?
  price                  Float
  quantity               Int          @default(1)
  variation              Json?
  sku                    String?
  shippingCost           Float        @default(0)
  shippingService        String?
  shippingCarrier        String?
  trackingNumber         String?
  estimatedDelivery      DateTime?
  actualDelivery         DateTime?
  acceptedAt             DateTime?
  shippedAt              DateTime?
  cancelledAt            DateTime?
  statusHistory          Json[]       @default([])
  itemStatus             ItemStatus   @default(pending)
  processedAt            DateTime?
  outForDeliveryAt       DateTime?
  returnStatus           ReturnStatus @default(none)
  returnReason           String?
  returnDescription      String?
  returnImages           String[]     @default([])
  returnRefundStatus     String?
  returnRequestedAt      DateTime?
  returnDecidedAt        DateTime?
  returnRejectionReason  String?
  returnReceivedBySeller Boolean      @default(false)
  returnReceivedAt       DateTime?
  isDigital              Boolean      @default(false)
  digitalDownloadUrl     String?
  subtotal               Float?

  courierCurrentLat        Float?
  courierCurrentLng        Float?
  courierAccuracy          Float?
  courierLocationUpdatedAt DateTime?
}

model Payment {
  id                     String            @id @default(uuid())
  buyerId                String
  buyer                  User              @relation("BuyerPayments", fields: [buyerId], references: [id])
  sellerId               String?
  seller                 User?             @relation("SellerPayments", fields: [sellerId], references: [id])
  paymentMethodId        String?
  paymentMethodRef       PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  amount                 Float
  currency               String            @default("USD")
  status                 TransactionStatus @default(pending)
  gateway                PaymentGateway    @default(stripe)
  gatewayTransactionId   String?
  gatewayPaymentIntentId String?
  gatewayResponse        Json?
  platformFee            Float             @default(0)
  gatewayFee             Float             @default(0)
  sellerPayout           Float             @default(0)
  refunds                Json[]            @default([])
  totalRefunded          Float             @default(0)
  description            String?
  failureReason          String?
  ipAddress              String?
  paidAt                 DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  orders Order[]

  @@index([buyerId])
  @@index([gatewayTransactionId])
  @@index([status])
}

model PaymentMethod {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  PaymentMethodType
  isDefault             Boolean           @default(false)
  cardLast4             String?
  cardBrand             String?
  cardExpMonth          Int?
  cardExpYear           Int?
  cardHolderName        String?
  stripePaymentMethodId String?
  paypalToken           String?
  paypalEmail           String?
  paypalAccountId       String?
  bankName              String?
  bankLast4             String?
  bankAccountType       String?
  stripeBankId          String?
  billingAddress        Json?
  isVerified            Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  payments Payment[]
}

model Review {
  id                 String       @id @default(uuid())
  listingId          String
  listing            Listing      @relation(fields: [listingId], references: [id])
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id])
  rating             Int
  comment            String
  images             Json[]       @default([])
  isVerifiedPurchase Boolean      @default(true)
  helpfulVotes       Int          @default(0)
  helpfulVoters      String[]     @default([])
  isVisible          Boolean      @default(false)
  status             ReviewStatus @default(pending)
  adminNote          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([listingId, userId, orderId])
  @@index([listingId])
  @@index([status])
}

model Feedback {
  id              String         @id @default(uuid())
  reviewerId      String
  reviewer        User           @relation("ReviewerFeedback", fields: [reviewerId], references: [id])
  revieweeId      String
  reviewee        User           @relation("RevieweeFeedback", fields: [revieweeId], references: [id])
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  listingId       String?
  listing         Listing?       @relation(fields: [listingId], references: [id])
  role            FeedbackRole
  rating          FeedbackRating
  score           Int
  comment         String?
  itemDescription Float?
  communication   Float?
  shippingTime    Float?
  shippingCost    Float?
  followUp        String?
  followUpDate    DateTime?
  reply           String?
  replyDate       DateTime?
  isReported      Boolean        @default(false)
  reportReason    String?
  isRemoved       Boolean        @default(false)
  removedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([reviewerId, orderId])
  @@index([revieweeId])
  @@index([orderId])
}

model Offer {
  id                String      @id @default(uuid())
  listingId         String
  listing           Listing     @relation(fields: [listingId], references: [id])
  buyerId           String
  buyer             User        @relation("BuyerOffers", fields: [buyerId], references: [id])
  sellerId          String
  seller            User        @relation("SellerOffers", fields: [sellerId], references: [id])
  offerPrice        Float
  quantity          Int         @default(1)
  message           String?
  status            OfferStatus @default(pending)
  counterOfferPrice Float?
  counterMessage    String?
  counterDate       DateTime?
  history           Json[]      @default([])
  expiresAt         DateTime?
  acceptedAt        DateTime?
  orderId           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  orders Order[]

  @@index([listingId, buyerId])
  @@index([sellerId, status])
}

model Question {
  id         String         @id @default(uuid())
  listingId  String
  listing    Listing        @relation(fields: [listingId], references: [id])
  buyerId    String
  buyer      User           @relation("BuyerQuestions", fields: [buyerId], references: [id])
  sellerId   String
  seller     User           @relation("SellerQuestions", fields: [sellerId], references: [id])
  question   String
  answer     String?
  status     QuestionStatus @default(pending)
  answeredAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([listingId])
  @@index([sellerId, status])
}

model FlashSale {
  id                    String          @id @default(uuid())
  listingId             String
  listing               Listing         @relation(fields: [listingId], references: [id])
  sellerId              String
  seller                User            @relation(fields: [sellerId], references: [id])
  discountPercentage    Float
  flashSalePrice        Float
  flashSaleStock        Int
  status                FlashSaleStatus @default(pending)
  emailStatus           EmailStatus     @default(not_sent)
  emailSentAt           DateTime?
  startTime             DateTime?
  endTime               DateTime?
  adminComment          String?
  originalPrice         Float?
  originalListingStatus String?
  batchId               String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status])
  @@index([listingId])
  @@index([batchId])
}

model SupportTicket {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation("TicketUser", fields: [userId], references: [id])
  subject      String
  message      String?
  type         SupportType
  status       SupportStatus   @default(open)
  priority     SupportPriority @default(medium)
  assignedToId String?
  assignedTo   User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  attachments  Json[]          @default([])
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  responses TicketResponse[]

  @@index([status, type])
  @@index([userId])
}

model TicketResponse {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id])
  message     String?
  attachments Json[]        @default([])
  isEdited    Boolean       @default(false)
  isDeleted   Boolean       @default(false)
  isAuto      Boolean       @default(false)
  replyTo     String?
  createdAt   DateTime      @default(now())
}

model Conversation {
  id            String           @id @default(uuid())
  listingId     String?
  listing       Listing?         @relation(fields: [listingId], references: [id])
  orderId       String?
  subject       String?
  lastMessageId String?
  lastMessageAt DateTime?
  isArchived    Boolean          @default(false)
  isSpam        Boolean          @default(false)
  type          ConversationType @default(general)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([listingId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  unreadCount    Int          @default(0)
  isArchived     Boolean      @default(false)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  attachments    Json[]       @default([])
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)
  isEdited       Boolean      @default(false)
  deletedBy      String[]     @default([])
  replyToId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SellerStore {
  id               String   @id @default(uuid())
  sellerId         String   @unique
  seller           User     @relation(fields: [sellerId], references: [id])
  storeName        String
  storeSlug        String   @unique
  description      String?
  logo             String?
  banner           String?
  website          String?
  returnPolicy     String?
  shippingPolicy   String?
  isVerified       Boolean  @default(false)
  verificationData Json?
  status           String   @default("pending")
  totalSales       Int      @default(0)
  totalRevenue     Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stripeConnectedAccountId String?
  stripeOnboardingComplete Boolean @default(false)

  storeViews StoreView[]
}

model StoreView {
  id      String      @id @default(uuid())
  storeId String
  store   SellerStore @relation(fields: [storeId], references: [id])
  userId  String?
  user    User?       @relation(fields: [userId], references: [id])
  date    String // YYYY-MM-DD
  views   Int         @default(0)

  @@unique([storeId, date])
}

model DraftOrder {
  id              String   @id @default(uuid())
  buyerId         String
  items           Json[]   @default([])
  shippingAddress Json
  billingAddress  Json?
  appliedVouchers Json?
  subtotal        Float
  shippingTotal   Float
  taxTotal        Float    @default(0)
  discountTotal   Float    @default(0)
  total           Float
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  targetRole String?
  title      String
  message    String
  link       String?
  data       Json?
  channel    String    @default("in_app")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead])
}

model Cart {
  id        String    @id @default(uuid())
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  coupon    String?
  subtotal  Float     @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items CartItem[]

  @@index([sessionId])
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id])
  quantity      Int      @default(1)
  variation     Json?
  price         Float
  savedForLater Boolean  @default(false)
  addedAt       DateTime @default(now())
}

model Coupon {
  id                   String    @id @default(uuid())
  code                 String    @unique
  description          String?
  type                 String // percentage, fixed_amount, free_shipping, bxgy
  value                Float
  minOrderAmount       Float     @default(0)
  maxDiscountAmount    Float?
  usageLimit           Int?
  usageCount           Int       @default(0)
  perUserLimit         Int       @default(1)
  applicableCategories String[]  @default([])
  applicableSellers    String[]  @default([])
  excludedListings     String[]  @default([])
  isActive             Boolean   @default(true)
  startDate            DateTime?
  endDate              DateTime?
  createdById          String?
  usageHistory         Json[]    @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Dispute {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  buyerId         String
  buyer           User      @relation("BuyerDisputes", fields: [buyerId], references: [id])
  sellerId        String
  seller          User      @relation("SellerDisputes", fields: [sellerId], references: [id])
  type            String
  status          String    @default("open")
  description     String
  attachments     Json[]    @default([])
  resolution      Json?
  timeline        Json[]    @default([])
  escalatedAt     DateTime?
  dueDate         DateTime?
  adminAssignedId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model EmailLog {
  id           String            @id @default(uuid())
  email        String
  campaignType EmailCampaignType
  productId    String
  status       String // sent, failed
  errorMessage String?
  sentAt       DateTime          @default(now())
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
